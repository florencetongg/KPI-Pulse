rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: Current app uses custom session auth (not Firebase Auth),
    // so request.auth is null. Keep scope limited to app collections.
    match /users/{userId} {
      allow read, write: if true;
    }

    match /kpi/{kpiId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
